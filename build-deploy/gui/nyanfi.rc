// wxWidgets が MSW で必要とするリソース (マニフェスト・標準カーソル・アイコン)。
// これをリンクしないと COMCTL32 v6 が有効にならず、wxApp::OnInit が失敗する
// (GUI サブシステムなので何も表示されず、終了コードだけが返る)。
//
// wx.rc の場所は CMake が find_file で解決して絶対パスで埋め込む。windres への
// インクルードパスの渡り方が環境で違い、MSYS2 では -I が効かなかったため。
#include "/home/kuwa72/opt/wx-3.3.3-mingw64/include/wx-3.3/wx/msw/wx.rc"
